FROM nvidia/cuda:12.8.1-devel-ubuntu24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates git curl wget xz-utils unzip python3 python3-pip python3-jinja2 \
    cmake ninja-build make pkg-config gcc-14 g++-14 gcc-13 g++-13 \
    libssl-dev libcurl4-openssl-dev libminiupnpc-dev libopus-dev \
    libpulse-dev libcap-dev libevdev-dev libudev-dev libnuma-dev \
    libva-dev libdrm-dev libgl-dev libegl-dev libgbm-dev \
    libx11-dev libx11-xcb-dev libxfixes-dev libxtst-dev \
    libxcb-shm0-dev libxcb-xfixes0-dev libxcb1-dev libxcb-dri3-dev \
    libxrandr-dev libwayland-dev libsystemd-dev \
    nodejs npm && rm -rf /var/lib/apt/lists/*
ENV CC=/usr/bin/gcc-14 CXX=/usr/bin/g++-14
ENV CUDAHOSTCXX=/usr/bin/g++-13
WORKDIR /src
